{
  "name": "@jannes64/ui",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:css",
    "copy:css": "rm -rf dist/styles && cp -r src/styles dist/styles",
    "dev": "tsc -p tsconfig.json --watch",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "react-router-dom": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react-router-dom": "^6.30.6",
    "typescript": "^5.6.3"
  }
}
